
DATABASE_URL=sqlite:///./fliptop.db
DATA_DIR=data

# YouTube caption fast path
# Tried in order. "fil" and "tl" are both used by YouTube for Filipino.
CAPTION_LANGS=fil,tl,en
USE_YOUTUBE_CAPTIONS=true

# Whisper drops speech under music and sometimes covers 30s with two words.
# Those holes are back-filled from the YouTube caption track.
FILL_WHISPER_GAPS=true

# Whisper fallback
# local = faster-whisper on this machine (free, slower)
# groq  = Groq cloud API (fast, accurate, needs GROQ_API_KEY)
# none  = never transcribe audio; YouTube captions only
TRANSCRIPTION_BACKEND=local

WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=tl
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# --- Groq (only needed when TRANSCRIPTION_BACKEND=groq)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# whisper-large-v3 is the most accurate; whisper-large-v3-turbo is cheaper
# and faster with a small accuracy cost on long audio.
GROQ_MODEL=whisper-large-v3

# Battles are long; audio is split into chunks below Groq's upload limit.
GROQ_CHUNK_SECONDS=600
GROQ_CHUNK_BITRATE=64k

# Free-tier ceilings. Raise these on a paid tier.
#   25 MB per upload, 20 requests/min, 8 hours of audio per day
GROQ_MAX_UPLOAD_MB=24
GROQ_REQUESTS_PER_MINUTE=20
GROQ_DAILY_AUDIO_SECONDS=28800
GROQ_MAX_RETRIES=5