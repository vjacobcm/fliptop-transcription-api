{
  "manifest_version": 3,
  "name": "FlipTop Companion",
  "version": "0.1.0",
  "description": "Timed FlipTop battle subtitles and mention highlights on YouTube.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlipTop Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["host.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-companion": {
      "suggested_key": {
        "default": "Alt+F"
      },
      "description": "Toggle FlipTop companion subtitles"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
